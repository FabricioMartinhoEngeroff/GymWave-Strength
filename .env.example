# Copie para .env.local e preencha. Nunca commite valores reais.
# Chave do proxy RapidAPI (ExerciseDB)
VITE_RAPIDAPI_KEY=

# Firebase Auth (obrigatório em produção; em DEV o login usa o gateway mock)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Admin fixo só para `npm run dev` (gateway mock). Nunca vai para o build de produção.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
